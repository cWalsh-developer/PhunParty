# ----------------------------------------------------------

# * This file is an example of environment variables for the PhunParty backend.
# ? Remove `.example` at the end of this file to use
# ! Do not commit `.env.credentials` to version control. !

# ----------------------------------------------------------

DB_HOST= localhost
DB_PORT= 5432
DB_USER= test_user
DB_PASSWORD= test_password
DB_NAME= test_phunparty
SECRET_KEY= test_secret_key_for_testing_only
ALGORITHM= HS256
ACCESS_TOKEN_EXPIRE_MINUTES= 30

# Email verification
# Resend API mode. This matches Resend's Python quickstart payload style.
RESEND_API_KEY= re_your_resend_api_key
RESEND_FROM= PhunParty <noreply@phun.party>
EMAIL_VERIFICATION_WEB_URL= https://phun.party/#/verify-email
EMAIL_VERIFICATION_APP_URL= phunpartymobileapp://verify-email
EMAIL_VERIFICATION_SECRET= replace_with_a_long_random_secret

# Optional SMTP mode. Leave blank if using RESEND_API_KEY.
SMTP_HOST=
SMTP_PORT= 587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME= PhunParty
SMTP_USE_TLS= true
